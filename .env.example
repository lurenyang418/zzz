# Optional service access token. When set, API requests require it.
ACCESS_TOKEN=

# Optional GitHub Token. A request-scoped browser Token takes precedence.
GITHUB_TOKEN=

# GitHub request timeout in seconds.
GITHUB_TIMEOUT_SECS=180
WRITE_TIMEOUT_SECS=1800

# Container-side path mapped to a host directory for folder/ZIP exports.
DOWNLOAD_ROOT=/downloads

MAX_FILES=10000
MAX_FILE_SIZE_BYTES=104857600
MAX_TOTAL_SIZE_BYTES=536870912
MAX_ZIP_SIZE_BYTES=536870912
MAX_TREE_REQUESTS=500
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MINUTE=30
LISTEN_ADDR=0.0.0.0:8080
